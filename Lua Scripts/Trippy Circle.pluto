local roll = 0
local xOffset = 1
local yOffset = 1
local finalValueX = 0
local finalValueY = 0
local xAnimOffset = 0
local yAnimOffset = 0
local staticX = 0
local staticY = 0
local staticR = 90
local staticRR = 90
local StaticH = -53 * 0.10
local StaticH_b = 0
local attach_position_z = 0

local circleRotation = 0
local circleAnimation = 0
local rotationAnimation = 0
local animationSpeed = 0

local animMin = 0
local animMax = 1
local oldSize = 0
