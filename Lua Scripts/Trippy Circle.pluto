    end
end)

------mons test space
anim_settings_root:slider('anim delay', {}, '', 0, 50, 0, 5, function (h) 
    animspeed = hS
end)--thats personal, but imo it should be just left at like 5 or even 0

local animoffset=0.01
anim_settings_root:slider('anim speed', {}, '', 1, 5, 1, 1, function (h) 
    animoffset = h/100
end)--1 to 5 seems fine to me

local isAnimation = false
anim_settings_root:toggle_loop('Anim Toggle', {"LRanim"}, 'Toggles the Animation of buses', function()
    isAnimation = true
    
    if sizeToggle then
        oldSize = size -- remembering size before animation
        sizeToggle = false
    end

    --animation itself
    while size>animMin do --to small (animMin)
        size-=animoffset
        util.yield(animspeed)
    end
    while size<animMax do --to big (animMax)
        size+=animoffset
        util.yield(animspeed)
    end

    isAnimation = false
end, function()
    while isAnimation do --waiting for anim to end
        util.yield()
    end
    size = oldSize --restoring old size
    sizeToggle = true

end)  

