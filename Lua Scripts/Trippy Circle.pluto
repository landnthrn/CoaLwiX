local animspeed=0

anim_settings_root:slider('Circle animation speed', {"LRCircleAnimationSpeed"}, 'Controls the speed of circle rotation', -10, 10, 0, 1, function(h)
    circleAnimation = h  /10
    local temp = h/10
    while circleAnimation == temp do
        circleRotation = animation(h/10, circleRotation, 360)
        util.yield()
    end
end)

anim_settings_root:slider('Rotation animation speed', {"LRRotaionAnimationSpeed"}, 'Controls the speed of Rotation animation', -10, 10, 0, 1, function(h)
    rotationAnimation=h/10
    local temp = h/10
    while rotationAnimation  == temp do
        rot = animation(h/10, rot, 360)
        util.yield()
    end
end)
 
